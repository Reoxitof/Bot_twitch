# =============================================
#   BOT TWITCH - STREAMER EN PAPIER
#   Copie ce fichier en .env et remplis les valeurs
# =============================================

# Nom d'utilisateur du bot Twitch (le compte bot)
BOT_USERNAME=nom_du_bot

# Token OAuth du bot (généré sur https://twitchapps.com/tmi/)
# Format: oauth:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BOT_OAUTH_TOKEN=oauth:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Nom de ta chaîne Twitch (en minuscules)
CHANNEL_NAME=streamer_en_papier

# Client ID de ton application Twitch (https://dev.twitch.tv/console)
TWITCH_CLIENT_ID=

# Client Secret de ton application Twitch
TWITCH_CLIENT_SECRET=

# Préfixe des commandes (par défaut: !)
COMMAND_PREFIX=!

# Cooldown global entre les commandes en secondes
COMMAND_COOLDOWN=3

# Active les logs détaillés (true/false)
DEBUG=false

# ── PostgreSQL (logs + points persistants) ────────────────────────────────────
PG_HOST=postgres-5ljq.internal
PG_PORT=5432
PG_DB=mydb
PG_USER=postgres
PG_PASSWORD=
